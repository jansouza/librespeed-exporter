librespeed_server_info{server="home",url="https://speed.example.com/"} 1
librespeed_server_info{server="lab",url="http://10.0.0.5:8080/"} 1
# HELP librespeed_test_duration_seconds How long the last librespeed-cli run took.
# TYPE librespeed_test_duration_seconds gauge
librespeed_test_duration_seconds{server="home"} 35.5
